# Newmota's common ESP-IDF defaults.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# Every runtime assertion check is kept, but a failing assert no longer carries
# its expression, file, and line. ESP-IDF's default level stringifies them, which
# adds a substantial amount of image rodata that grows with the SDK code using
# assertions. HAL and lwIP assertions follow this level through their own
# equal-to-system settings.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_LIBC_PICOLIBC=y
CONFIG_LIBC_PICOLIBC_NEWLIB_COMPATIBILITY=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
