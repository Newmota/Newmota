# BL618DG defaults for the BouffaloSDK native build.
CONFIG_ROMAPI=y
CONFIG_DEBUG=y
CONFIG_TLSF=y
CONFIG_COREDUMP=y
CONFIG_ANTI_ROLLBACK=n
CONFIG_APP_ANTI_ROLLBACK_VER=0
CONFIG_XTAL_POWER_TYPE_ACTIVE=n
CONFIG_CONSOLE_UART_BAUDRATE=2000000
CONFIG_VSNPRINTF_NANO=n
CONFIG_VSNPRINTF_FLOAT=n
CONFIG_VSNPRINTF_LONG_LONG=y
CONFIG_BFLB_LOG=n
CONFIG_GCC_OPTIMISE_LEVEL="-Os"
CONFIG_FREERTOS=y
CONFIG_POSIX=n
CONFIG_SHELL=n
CONFIG_LWIP=y
CONFIG_DHCPD=y
CONFIG_RF=y
CONFIG_WIFI6=y
CONFIG_FHOST=y
CONFIG_MACSW_SELECT=default
CONFIG_MACSW_LOG_NO_PRINT=y
CONFIG_MBEDTLS=y
CONFIG_PARTITION=y
CONFIG_BFLB_MTD=y
# Run single-core: the AP owns all 320 KiB of Wi-Fi RAM and no NP image is booted.
CONFIG_DUALCORE_DISABLE=y
CONFIG_WRAM_FOR_AP_SIZE=0x50000
# The managed Xuantie GCC 14 toolchain supplies Newlib, including for B0.
CONFIG_PICOLIBC=n
# Safeboot accepts only images whose native header CRC and SHA-256 are checked.
CONFIG_ENABLE_IMG_CRC=y
CONFIG_ENABLE_IMG_HASH=y
