{
  "chip": "esp32s31",
  "flash": {
    "size_kb": 16384,
    "mode": "qio",
    "frequency_mhz": 80
  },
  "psram": {
    "size_kb": 16384,
    "mode": "octal",
    "frequency_mhz": 200
  },
  "console": "usb-serial-jtag",
  "profile_default": "Large",
  "gpio": {
    "source": "https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32s31/esp32-s31-function-coreboard-1/user_guide.html",
    "exposed": [
      0, 1, 2, 3, 4,
      20, 21, 22, 23, 24, 25,
      35, 36, 37, 38, 39, 40,
      42, 43, 44, 45, 46, 47, 48, 49,
      58, 59, 60, 61
    ],
    "reserved": {
      "rgb-led": [60],
      "boot-button": [61]
    }
  }
}
