# Solidify the objects named by the `#@ solidify:<name>[,weak]` lines of one Berry source.
# Arguments: <source.be> <output.h> [--globals=<name>,...] [<source the first one extends>...].
# Run by tools/newmota/berry.py through the Python Berry port.
import global
import re
import solidify
import string

# Sources reach each other through the native module; it only has to exist for compilation.
global.matter = module("matter")
global.newmota = module("newmota")
global.log = def () end
# Firmware globals a driver file names, declared so that it compiles on the host.
var inherited_sources = []
for argument : _argv[3 ..]
  if string.find(argument, "--globals=") == 0
    for name : string.split(argument[10 ..], ",")
      global.(name) = module(name)
    end
  else
    inherited_sources.push(argument)
  end
end
# Classes other sources extend have to exist before those sources run.
for inherited : inherited_sources
  var inherited_file = open(inherited)
  var inherited_source = inherited_file.read()
  inherited_file.close()
  compile(inherited_source)()
end

var source_file = open(_argv[1])
var source = source_file.read()
source_file.close()
compile(source)()

var output = open(_argv[2], "w")
output.write('/* Generated by tools/newmota/berry_solidify.be; do not edit. */\n')
output.write('#include "be_constobj.h"\n')
for directive : re.searchall("#@\\s*solidify:([A-Za-z0-9_,]+)", source)
  var parts = string.split(directive[1], ",")
  solidify.dump(global.(parts[0]), parts.find("weak") != nil, output)
end
output.close()
