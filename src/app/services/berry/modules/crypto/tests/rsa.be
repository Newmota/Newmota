# Optional device RSA fixture; also executed unchanged by the host Berry VM.
# RSA PKCS#1/PKCS#8 signing compared with the OpenSSL fixture below.
import crypto
import gc
import introspect
def rejects(operation)
  var failed=false
  try
    operation()
  except 'value_error', 'type_error'
    failed=true
  end
  assert(failed)
end
if introspect.contains(crypto,'RSA')
  # Public test key generated for this fixture; never use it as a real identity.
  # OpenSSL 4.0.3 (2026-10-01): genrsa 1024; rsa -traditional -outform DER;
  # pkcs8 -topk8 -nocrypt -outform DER; dgst -sha256 -sign on ASCII 'sample'.
  var rsa_pkcs1=bytes('')
  var rsa_pkcs8=bytes('')
  var rsa_expected=bytes('d0ea21456f0685508f9c1b54084192727da2ae65c14122c15477e2bdd4881dc9bd5241249857391e807e097fbe6f2b296486bdd9113538bdacecc676890d90b00a5f2d7f770554021776c3920e4edbb76dc377a777b861486ccf32334d0575593ffbb81b0152ade6eca6a6f26ae68c84ca4f6fb244fd662c861b7f0485a6f56c')
  assert(crypto.RSA.rs256(rsa_pkcs1,bytes().fromstring('sample'))==rsa_expected)
  gc.collect()
  assert(crypto.RSA.rs256(rsa_pkcs8,bytes().fromstring('sample'))==rsa_expected)
  rejects(/-> crypto.RSA.rs256(bytes('00'),bytes()))
  print('PASS RSA')
else
  print('SKIP RSA: API not selected')
end
